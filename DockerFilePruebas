# Imagen CI: instala dependencias (package-lock.json), compila TypeScript,
# ejecuta pruebas unitarias con Vitest y genera cobertura V8.
#
# Uso:
#   docker build -f DockerFilePruebas -t games-tournament-back-tests .
#   docker run --rm games-tournament-back-tests
#
# Cobertura HTML en el contenedor: /app/coverage/
#   docker run --rm -v "$(pwd)/coverage:/app/coverage" games-tournament-back-tests

FROM node:22-bookworm-slim

WORKDIR /app

# Dependencias según package.json; npm ci si el lock está sincronizado (recomendado tras npm install local)
COPY package.json package-lock.json ./

RUN npm ci --include=dev || npm install

COPY prisma ./prisma
COPY prisma.config.ts tsconfig.json vitest.config.ts ./
COPY src ./src
COPY tests ./tests

ENV NODE_ENV=test
# Prisma generate no conecta a la BD; URL dummy solo para prisma.config.ts
ENV DATABASE_URL="postgresql://ci:ci@127.0.0.1:5432/ci?schema=public"
ENV JWT_SECRET="docker-test-access-secret-min-32-chars-long!!"
ENV JWT_REFRESH_SECRET="docker-test-refresh-secret-min-32-chars-long!!"

RUN npx prisma generate

RUN npm run build

RUN npm run test:coverage

# # 3) Se deja la imagen con un mando genérico para que el contenedor siga activo
CMD ["tail", "-f", "/dev/null"]
