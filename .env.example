# Copiar a .env y ajustar valores (no subir .env al repositorio).

# PostgreSQL — URL de conexión para Prisma y la app
# Ejemplo: postgresql://USUARIO:CONTRASENA@localhost:5432/torneos_db?schema=public
DATABASE_URL="postgresql://usuario:password@localhost:5432/torneos_db?schema=public"

# JWT (definir secretos seguros en producción)
JWT_SECRET="cambiar_en_produccion"
JWT_REFRESH_SECRET="cambiar_refresh_en_produccion"
JWT_EXPIRES_IN="1h"
JWT_REFRESH_EXPIRES_IN="7d"

PORT=3000
NODE_ENV=development

# Origen del frontend (CORS y Socket.io)
FRONTEND_URL="http://localhost:5173"
